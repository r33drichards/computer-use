# Platform-owned. One per session, generated by the operator; {{SESSION_ID}}
# is the session's ID. This is the document mcp-js asks for.
package browserjs.decision["{{SESSION_ID}}"].mcp_tools

import rego.v1

default allow := false

# The servers of a session and their tools. A call to anything else is
# refused whatever the tenant's policy says: a policy written before a tool
# existed cannot have meant to allow it. A tool is added here in the pull
# request that adds its input to rego-contract.md.
allow if {
	input.tool in {
		"browser": {"browser_execute", "desktop_execute"},
		"exec": {"exec", "kill", "search_logs", "stream_logs"},
	}[input.server]
	data.browserjs.tenant["{{SESSION_ID}}"].allow_tool_call == true
}

# Fetch uses the same tenant entry rule and decision endpoint. The local
# image policy also limits requests to HTTP(S).
allow if {
	input.operation == "fetch"
	input.url_parsed.scheme in {"http", "https"}
	data.browserjs.tenant["{{SESSION_ID}}"].allow_tool_call == true
}

# Pinned loader redirects are not reauthorized. Only an explicit context-free
# full module-network grant can permit retrieval; no URL/model-supplied grant.
allow if {
	input.resolved_url == input.specifier
	input.url_parsed.scheme in {"http", "https"}
	data.browserjs.tenant["{{SESSION_ID}}"].allow_unrestricted_modules == true with input as {}
}
